{
  "name": "cellular-learning-app",
  "productName": "Cell Learning",
  "version": "0.1.0",
  "description": "Personal Duolingo-style app for US LTE/5G bands and cell identification (working name).",
  "main": "electron/main.cjs",
  "author": "Lukas",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "e2e": "npm run build && playwright test",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@playwright/test": "^1.64.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "canvas-confetti": "^1.9.4",
    "electron": "^45.2.1",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
